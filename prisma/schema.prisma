generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model IngestionRun {
  id           String          @id @default(cuid())
  status       IngestionStatus @default(RUNNING)
  sourceCount  Int             @default(0)
  successCount Int             @default(0)
  failureCount Int             @default(0)
  chunkCount   Int             @default(0)
  errorSummary String?         @db.Text
  startedAt    DateTime        @default(now())
  completedAt  DateTime?

  @@index([status, startedAt])
}

model KnowledgeSource {
  id          String           @id @default(cuid())
  key         String           @unique
  title       String
  kind        String
  url         String           @unique @db.VarChar(500)
  content     String?          @db.LongText
  contentHash String?
  fetchedAt   DateTime?
  httpStatus  Int?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  citations   Citation[]
  chunks      KnowledgeChunk[]

  @@index([isActive, updatedAt])
}

model KnowledgeChunk {
  id             String          @id @default(cuid())
  sourceId       String
  chunkIndex     Int
  heading        String?
  content        String          @db.Text
  normalizedText String          @db.Text
  contentHash    String
  tokenCount     Int             @default(0)
  createdAt      DateTime        @default(now())
  citations      Citation[]
  source         KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, contentHash])
  @@index([sourceId, chunkIndex])
  @@index([createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  locale    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  leads     Lead[]
  messages  Message[]

  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  unanswered     Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())
  citations      Citation[]
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([role, unanswered])
}

model Citation {
  id        String          @id @default(cuid())
  messageId String
  sourceId  String
  chunkId   String?
  label     String
  url       String          @db.VarChar(500)
  chunk     KnowledgeChunk? @relation(fields: [chunkId], references: [id])
  message   Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([messageId, sourceId])
  @@index([sourceId])
  @@index([chunkId], map: "Citation_chunkId_fkey")
}

model Lead {
  id             String        @id @default(cuid())
  conversationId String?
  name           String
  email          String
  message        String?       @db.Text
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@index([createdAt])
  @@index([email])
  @@index([conversationId], map: "Lead_conversationId_fkey")
}

enum IngestionStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}
